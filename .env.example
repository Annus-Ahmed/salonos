# Recommended production database: MongoDB Atlas or another replica set.
MONGODB_URI=
MONGODB_DATABASE=salonos

# PostgreSQL fallback for existing installations and local demo tools.
DATABASE_URL=postgresql://salonos:replace-local-password@localhost:5432/salonos
DATABASE_SSL=false
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_MODE=false
# Used ONLY for db:seed with DEMO_MODE=true. Minimum 12 characters.
DEMO_MANAGER_PASSWORD=
DEMO_OWNER_PASSWORD=

# Used by Docker Compose for local PostgreSQL. Must match DATABASE_URL.
POSTGRES_PASSWORD=replace-local-password

# Optional booking confirmations. Set all three to enable SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
